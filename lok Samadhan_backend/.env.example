PORT=5000
NODE_ENV=development

# Gemini API / Gemma Model Configuration
# Obtain your free API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Configurable model: e.g., gemma-2-27b-it, gemma-2-9b-it, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash

# Supabase Configuration
# Obtain from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Direct PostgreSQL Database URL (Alternative or direct pool, e.g. Supabase Postgres or DigitalOcean Managed Database)
# Format: postgresql://postgres:password@db.example.com:5432/postgres
DATABASE_URL=

# OpenStreetMap Nominatim Configuration
OSM_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSM_USER_AGENT=LokSamadhan-CivicApp/1.0 (contact@lok-samadhan.gov.in)

# JWT Secret for Auth
JWT_SECRET=lok_samadhan_jwt_secret_change_in_production_2026
JWT_EXPIRES_IN=7d
//&
# CORS Allowed Origins (Comma separated, * for all)
CORS_ORIGIN=*
